# Copy this file to .env (it is git-ignored) and fill it in. Never commit real credentials.

# The Instagram account the reels are browsed with. Use a spare account, not your main one:
# instagrapi is an unofficial client and Instagram can lock accounts that use it.
IG_USERNAME=
IG_PASSWORD=

# Only if the account has 2-factor login: a current code from your authenticator app.
# It is only needed the first time; after that the saved session.json is reused.
IG_VERIFICATION_CODE=

# Optional: play the .mp4 files in this folder instead of Instagram (no login needed).
# REELS_MOCK_DIR=./mock_videos

# Optional: change the port (the Vite dev server expects 8765).
# REELS_PORT=8765
